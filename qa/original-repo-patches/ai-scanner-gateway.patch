+
+
+def test_the_installer_default_is_saved_once(monkeypatch):
+    monkeypatch.setenv("GATEWAY_DEFAULT_AI_PRESET", "openai")
+    monkeypatch.setenv("GATEWAY_DEFAULT_AI_MODEL", "gpt-4.1-mini")
+    monkeypatch.setenv("GATEWAY_DEFAULT_AI_KEY", KEY)
+    with gateway_db.get_session() as session:
+        assert site_settings.seed_ai_from_env(session) is True
+        saved = site_settings.ai_for_review(session)
+        assert saved == {"preset": "openai", "endpoint": "", "model": "gpt-4.1-mini",
+                         "api_key": KEY}
+        # an admin's later choice is never overwritten by a restart
+        site_settings.save_ai(session, preset="groq", endpoint="", model="m",
+                              api_key="gsk-0123456789", clear_key=False, who="site-admin")
+        assert site_settings.seed_ai_from_env(session) is False
+        assert site_settings.ai_public(session)["preset"] == "groq"
+
+
+def test_no_installer_default_means_nothing_is_saved(monkeypatch):
+    monkeypatch.delenv("GATEWAY_DEFAULT_AI_PRESET", raising=False)
+    with gateway_db.get_session() as session:
+        assert site_settings.seed_ai_from_env(session) is False
+        assert site_settings.ai_public(session) == {"configured": False}
+
+
+def test_a_local_default_needs_no_key(monkeypatch):
+    monkeypatch.setenv("GATEWAY_DEFAULT_AI_PRESET", "local")
+    monkeypatch.setenv("GATEWAY_DEFAULT_AI_ENDPOINT", "http://lmstudio:1234/v1")
+    monkeypatch.delenv("GATEWAY_DEFAULT_AI_KEY", raising=False)
+    with gateway_db.get_session() as session:
+        assert site_settings.seed_ai_from_env(session) is True
+        assert site_settings.ai_public(session)["endpoint"] == "http://lmstudio:1234/v1"
