diff --git a/ci/deploy-lib.sh b/ci/deploy-lib.sh
index ff2db1f..9894010 100644
--- a/ci/deploy-lib.sh
+++ b/ci/deploy-lib.sh
@@ -25,6 +25,15 @@ clone_deploy_repo() {
 #       newTag: <tag>
 # Safe to run again: an existing newName line is replaced, not duplicated.
 set_image() {
+    # An install made by ai-scanner-installer sets DEPLOY_ENV (Jenkins global
+    # variable): its images live in overlays/<env>/app-patch.yaml as full
+    # "image: <registry>/<name>:<tag>" lines.
+    if [ -n "${DEPLOY_ENV:-}" ]; then
+        f="overlays/${DEPLOY_ENV}/app-patch.yaml"
+        sed -i "s|image: [^ ]*/$1:[^ ]*|image: ${REGISTRY}/$1:${TAG}|" "$f"
+        grep -q "image: ${REGISTRY}/$1:${TAG}" "$f" || { echo "set_image: no image line for $1 in $f" >&2; exit 1; }
+        return 0
+    fi
     sed -i -e "/- name: $1 /,/newTag:/{/newName:/d;s|^    newTag:.*|    newName: ${REGISTRY}/$1                    # set by Jenkins: the registry it was pushed to\n    newTag: ${TAG}                               # set by Jenkins: the commit it was built from|}" "$2"
     grep -q "newName: ${REGISTRY}/$1 " "$2" || { echo "set_image: no images entry for $1 in $2" >&2; exit 1; }
 }
