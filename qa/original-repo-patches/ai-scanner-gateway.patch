--- a/tests/test_site_settings.py
+++ b/tests/test_site_settings.py
@@ -205,3 +205,35 @@ def test_still_stopping_is_a_409_and_the_row_stays():
     session = gateway_db.get_session()
     assert session.get(gateway_db.Trigger, trigger_id) is not None
