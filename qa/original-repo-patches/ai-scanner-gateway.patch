+def seed_ai_from_env(db: Session) -> bool:
+    """The installer's default AI service, applied ONCE: when no AI choice
+    is saved yet and GATEWAY_DEFAULT_AI_PRESET is set, save it as if an
+    admin had chosen it. A saved choice always wins, so an admin's change
+    in Settings is never overwritten by a restart. Returns True if seeded.
+
+        GATEWAY_DEFAULT_AI_PRESET    local | openai | anthropic | google | groq | openrouter | mistral
+        GATEWAY_DEFAULT_AI_ENDPOINT  only for "local": the model server's /v1 address
+        GATEWAY_DEFAULT_AI_MODEL     the model id (empty: the service's default)
+        GATEWAY_DEFAULT_AI_KEY       the API key (from a Secret, never a plain value)
+    """
+    preset = os.environ.get("GATEWAY_DEFAULT_AI_PRESET", "").strip()
+    if not preset or _row(db) is not None:
+        return False
+    api_key = os.environ.get("GATEWAY_DEFAULT_AI_KEY", "").strip()
+    if api_key and not encryption_ready():
+        log.warning("GATEWAY_DEFAULT_AI_KEY is set but GATEWAY_SETTINGS_KEY is "
+                    "not; the default AI service was not saved")
+        return False
+    save_ai(db, preset=preset,
+            endpoint=os.environ.get("GATEWAY_DEFAULT_AI_ENDPOINT", "").strip(),
+            model=os.environ.get("GATEWAY_DEFAULT_AI_MODEL", "").strip(),
+            api_key=api_key or None, clear_key=False, who="installer")
+    log.info("AI service set to %s from the installer's default", preset)
+    return True
+
+
 def clear_ai(db: Session) -> None:
