diff --git a/ingress/kustomization.yaml b/ingress/kustomization.yaml
new file mode 100644
index 0000000..cc32877
--- /dev/null
+++ b/ingress/kustomization.yaml
@@ -0,0 +1,6 @@
+# A Kustomize unit for this folder, so the installer's overlays (overlays/<env>/)
+# can use it. The root kustomization.yaml still lists these files directly.
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+resources:
+  - ingress.yaml
